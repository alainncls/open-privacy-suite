# Privacy Proxy — Production Environment Variables
# Copy to .env and fill in your values:
#   cp .env.production.example .env

# === Required ===

# Docker image version (from DockerHub releases)
PRIVACY_PROXY_VERSION=v0.5.0

# Public URL where the proxy is reachable (used for OAuth callbacks, CORS)
BASE_URL=https://proxy.yourdomain.com

# Ethereum node URL (JSON-RPC endpoint)
NODE_URL=http://your-ethereum-node:8545

# JWT secrets — generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Admin API token — generate with: openssl rand -hex 32
ADMIN_API_TOKEN=

# Privado verifier DID — identifies this proxy when requesting ZK proofs.
# This is a self-chosen identifier (no registration needed). Pick any
# unique DID string for your deployment. The wallet shows this to the user
# and the proof response is checked against it for consistency.
# Only needed if using Privado ID auth (not needed for Azure AD-only setups).
VERIFIER_ID=did:privado:verifier:your-network-name

# Database connection string
# Use the built-in postgres (default) or point to an external DB
DATABASE_URL=postgres://postgres:postgres@postgres:5432/privacy_proxy?sslmode=disable

# === Optional ===

# Password for the built-in postgres container (default: postgres)
# POSTGRES_PASSWORD=postgres

# CORS allowed origins (default: same as BASE_URL)
# CORS_ALLOWED_ORIGINS=https://proxy.yourdomain.com,https://explorer.yourdomain.com

# Additional CIDRs for internal API access (comma-separated)
# Appended to defaults: localhost, Docker (172.16/12), RFC1918 (10/8, 192.168/16), Tailscale (100.64/10)
# TRUSTED_INTERNAL_CIDRS=10.100.0.0/16,fd00::/8

# Host ports (default: 8080 for backend, 5173 for frontend)
# HOST_PORT_PROXY=8080
# HOST_PORT_UI=5173

# Azure AD / Microsoft Entra ID (optional SSO)
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=

# Explorer database (for block-explorer integration)
# EXPLORER_DATABASE_URL=postgres://user:pass@explorer-db:5432/explorer?sslmode=disable

# CoinGecko price fetching (disable if no internet access)
# DISABLE_COINGECKO=true

# Travel rule compliance enforcement
# ENABLE_TRAVEL_RULE=true
