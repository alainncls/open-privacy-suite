#!/bin/bash
set -e

echo "Running pre-commit checks..."

# Format Go code
echo "Formatting Go code..."
gofmt -w $(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

# Run go vet
echo "Running go vet..."
go vet ./...

# Run Go tests on changed packages
CHANGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' | grep -v '_test\.go$' || true)
if [ -n "$CHANGED_GO_FILES" ]; then
    echo "Running tests on changed packages..."
    PACKAGES=$(echo "$CHANGED_GO_FILES" | xargs -I{} dirname {} | sort -u | sed 's|^|./|')
    go test $PACKAGES -short
fi

# Lint frontend if frontend files changed
CHANGED_FRONTEND=$(git diff --cached --name-only --diff-filter=ACM | grep '^frontend/' || true)
if [ -n "$CHANGED_FRONTEND" ]; then
    echo "Linting frontend..."
    cd frontend && npm run lint
fi

echo "Pre-commit checks passed!"
