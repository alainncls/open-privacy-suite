#!/bin/bash
set -e

echo "=========================================="
echo "Running pre-commit checks (thorough mode)"
echo "=========================================="

# Format Go code
echo ""
echo ">>> Formatting Go code..."
gofmt -w .

# Run go vet
echo ""
echo ">>> Running go vet..."
go vet ./...

# Run ALL Go tests
echo ""
echo ">>> Running Go unit tests..."
make test-unit

# Run frontend tests
echo ""
echo ">>> Running frontend tests..."
make frontend-test

# Run the Dockerized browser lane. The complete server gate is deliberately
# available as `make e2e` without making every local commit start privacy and
# both Go E2E lanes after the unit suite.
echo ""
echo ">>> Running Playwright E2E tests..."
make e2e-playwright

echo ""
echo "=========================================="
echo "All checks passed!"
echo "=========================================="
