#!/bin/bash
set -e

echo "=========================================="
echo "Running pre-commit checks (thorough mode)"
echo "=========================================="

# Format Go code
echo ""
echo ">>> Formatting Go code..."
gofmt -w .

# Run go vet
echo ""
echo ">>> Running go vet..."
go vet ./...

# Run ALL Go tests
echo ""
echo ">>> Running Go unit tests..."
make test-unit

# Run frontend tests
echo ""
echo ">>> Running frontend tests..."
make frontend-test

# Run E2E tests
echo ""
echo ">>> Running E2E tests..."
make e2e

echo ""
echo "=========================================="
echo "All checks passed!"
echo "=========================================="
