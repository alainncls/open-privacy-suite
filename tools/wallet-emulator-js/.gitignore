dist/

# Identity files contain a private key. Never commit, even for tests.
*identity*.json
!example-identity.json

# Named test identities created by scripts/create-test-identities.sh are
# intentionally committed: they are deterministic (seed = sha256("...:<name>"))
# and exist only for staging/dev. See the script header for the security
# rationale.

# Wallet state directory created by `identity init`.
.wallet-state/

