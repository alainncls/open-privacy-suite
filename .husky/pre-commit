#!/bin/sh

# Run lint-staged for targeted checks on staged files
npx lint-staged

# Run go vet on entire project (lint-staged can't handle this correctly)
echo "Running go vet..."
go vet ./... || exit 1

# Run Go tests on changed packages (faster than full test suite)
echo "Running Go tests on changed packages..."
CHANGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' | grep -v '_test\.go$' || true)
if [ -n "$CHANGED_GO_FILES" ]; then
  # Extract unique package directories
  PACKAGES=$(echo "$CHANGED_GO_FILES" | xargs -I{} dirname {} | sort -u | sed 's|^|./|')
  go test $PACKAGES -v -short || exit 1
fi

echo "Pre-commit checks passed!"
