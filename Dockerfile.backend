FROM golang:1.21-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build (CGO disabled - pgx/v5 is pure Go, no C dependencies needed)
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/bin/privacy-proxy ./cmd/server

# Final stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates wget postgresql-client

WORKDIR /app

COPY --from=builder /app/bin/privacy-proxy .

EXPOSE 8080

# Start server (migrations run automatically on connection)
CMD ["./privacy-proxy"]
