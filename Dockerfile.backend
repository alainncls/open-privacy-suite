FROM golang:1.24-bookworm AS builder

# Install build dependencies for CGO (required by go-rapidsnark)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgmp-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build with CGO enabled (required by go-rapidsnark/prover)
RUN CGO_ENABLED=1 GOOS=linux go build -tags production -o /app/bin/privacy-proxy ./cmd/server

# Final stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    postgresql-client \
    libgmp10 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/bin/privacy-proxy .

EXPOSE 8080

# Start server (migrations run automatically on connection)
CMD ["./privacy-proxy"]
